{
  "name": "matin-chess",
  "productName": "MATIN CHESS",
  "version": "3.0.0",
  "description": "MATIN CHESS — Windows Desktop Edition (same look & engines as the Android app)",
  "author": "AmirMohammad Golestan & Matin Katooei-zadeh",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis --publish never",
    "dist:portable": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.matinchess.game",
    "productName": "MATIN CHESS",
    "copyright": "© AmirMohammad Golestan & Matin Katooei-zadeh",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "win": {
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "MATIN-CHESS-v${version}-windows-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "MATIN-CHESS-v${version}-windows-setup.${ext}"
    }
  }
}
